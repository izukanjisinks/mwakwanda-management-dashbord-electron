{
  "name": "lodge-terminal",
  "version": "0.1.0",
  "description": "Reception terminal shell for the Lodge Management System backoffice. Loads the live backoffice web app and bridges raw TCP printing to the branch's local receipt printer, which browsers cannot do directly.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch main.js --watch preload.js --watch config.json --exec electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.mwakwanda.lodge-terminal",
    "productName": "Lodge Terminal",
    "win": {
      "target": "nsis",
      "icon": "logo/mwakwanda-logo.ico",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json"
    ]
  },
  "dependencies": {
    "node-thermal-printer": "^4.6.0"
  }
}
